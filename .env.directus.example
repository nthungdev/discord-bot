# ==============================================================================
# Directus Local Development Stack Environment Variables
# ==============================================================================
# Used by compose.directus-dev.yaml when running:
#   docker compose -f compose.directus-dev.yaml up -d
#
# To customize these values, copy this file to .env (or run with --env-file .env.directus):
#   cp .env.directus.example .env

# ------------------------------------------------------------------------------
# PostgreSQL Service Settings
# ------------------------------------------------------------------------------
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus_dev_password
POSTGRES_DB=directus
# Host port mapping for PostgreSQL (defaults to 5433 to avoid conflicts with local PostgreSQL on 5432)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Directus Core & Security Settings
# ------------------------------------------------------------------------------
# Host port mapping for Directus Web Admin and API
DIRECTUS_PORT=8055
# 32+ character random secret keys used by Directus for hashing and token generation
DIRECTUS_KEY=local-dev-directus-secret-key-32chars
DIRECTUS_SECRET=local-dev-directus-secret-token-32
# Public URL through which Directus is reachable from browsers / external callers
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ------------------------------------------------------------------------------
# Directus Admin Bootstrap Credentials
# ------------------------------------------------------------------------------
# Initial administrator credentials used during first container initialization
# and by the bootstrap CLI script (pnpm --prefix app directus:setup).
DIRECTUS_ADMIN_EMAIL=admin@local.dev
DIRECTUS_ADMIN_PASSWORD=adminpassword
