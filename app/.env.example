# ==============================================================================
# Discord Application Configuration (Unified Bot & Management Portal)
# ==============================================================================
# Discord Bot Token from Developer Portal (Required)
DISCORD_TOKEN=
# Discord Application Client ID (Required for bot invite link, slash commands & OAuth2)
DISCORD_CLIENT_ID=
# Discord Application Client Secret (Required for management portal OAuth2 login)
DISCORD_CLIENT_SECRET=
# Discord OAuth2 Redirect URI (Must match Redirect URI in Discord Developer Portal)
DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/auth/discord/callback

# ==============================================================================
# AI Provider Configuration (Google GenAI / Gemini)
# ==============================================================================
# Google AI Studio / Gemini API Key (Required)
AI_API_KEY=

# ==============================================================================
# Security & Access Control
# ==============================================================================
# Secret Bearer token for REST API endpoints (Required)
BEARER_TOKEN=
# Secret key used to sign Discord OAuth2 session cookies (Optional, default fallback used if empty)
SESSION_SECRET=
# Comma-separated Discord User IDs for Super Admins
ADMIN_DISCORD_USER_IDS=

# ==============================================================================
# Storage & Persistence Backend
# ==============================================================================
# Conversation memory storage: 'local' (file-based), 'firestore' (Cloud Firestore), or 'directus'
MEMORY_STORE_TYPE=local

# ==============================================================================
# Server & Runtime Configuration
# ==============================================================================
PORT=3001
NODE_ENV=development
USE_CONFIG_FILE=true
CONFIG_PATH=

# ==============================================================================
# Feature & Capability Toggles
# ==============================================================================
# Police & moderation capabilities (Popogon). Disabled by default. Set to 'true' to enable.
ENABLE_POLICE_CAPABILITY=false

# ==============================================================================
# Directus Headless Management & Control Plane
# ==============================================================================
# To enable Directus for opt-out and state management, set MEMORY_STORE_TYPE=directus above.
# Directus API Base URL (Local dev: http://localhost:8055, Production: https://directus.yourdomain.local)
DIRECTUS_URL=http://localhost:8055
# Static service token generated for bot-service user (required when using Directus & running directus:setup)
DIRECTUS_BOT_TOKEN=your-directus-bot-service-token-here
# Shared secret for Directus Flow webhook cache invalidation requests (optional, recommended)
INTERNAL_WEBHOOK_SECRET=your-internal-webhook-secret-here
# Webhook receiver URL provisioned in Directus for cache invalidation.
# Directus runs in Docker; host.docker.internal allows the container to reach the host bot on port 3001.
WEBHOOK_RECEIVER_URL=http://host.docker.internal:3001/api/v1/webhooks/cache-invalidate


# Directus Admin Credentials (used by 'pnpm --prefix app directus:setup' to bootstrap schema & permissions)
DIRECTUS_ADMIN_EMAIL=admin@local.dev
DIRECTUS_ADMIN_PASSWORD=adminpassword