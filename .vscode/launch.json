{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app: debug watch",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "debug"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/app/.env.development"
    },
    {
      "name": "app: debug start",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "ts-node", "src/main.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/app/.env.development"
    },
    {
      "name": "app: debug compiled",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/build/src/main.js",
      "preLaunchTask": "build",
      "outFiles": ["${workspaceFolder}/app/build/**/*.js"],
      "sourceMaps": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/app/.env.development"
    },
    {
      "name": "app: attach (port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/app"
    }
  ]
}
