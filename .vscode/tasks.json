{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Compile TypeScript app with pnpm",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "typecheck",
      "detail": "Run TypeScript typecheck with pnpm",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "typecheck"],
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "kill debug ports (9229, 3001)",
      "detail": "Force kill any lingering processes on ports 9229 and 3001",
      "type": "shell",
      "command": "lsof -ti:9229,3001 | xargs kill -9 2>/dev/null || true",
      "problemMatcher": []
    }
  ]
}
