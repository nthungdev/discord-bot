# ==============================================================================
# Discord Application Configuration (Unified Bot & Management Portal)
# ==============================================================================
# Discord Bot Token from Developer Portal (Required)
DISCORD_TOKEN=
# Discord Application Client ID (Required for bot invite link, slash commands & OAuth2)
DISCORD_CLIENT_ID=
# Discord Application Client Secret (Required for management portal OAuth2 login)
DISCORD_CLIENT_SECRET=
# Discord OAuth2 Redirect URI (Must match Redirect URI in Discord Developer Portal)
DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/auth/discord/callback

# ==============================================================================
# AI Provider Configuration (Google GenAI / Gemini)
# ==============================================================================
# Google AI Studio / Gemini API Key (Required)
AI_API_KEY=

# ==============================================================================
# Security & Access Control
# ==============================================================================
# Secret Bearer token for REST API endpoints (Required)
BEARER_TOKEN=
# Secret key used to sign Discord OAuth2 session cookies (Optional, default fallback used if empty)
SESSION_SECRET=
# Comma-separated Discord User IDs for Super Admins
ADMIN_DISCORD_USER_IDS=

# ==============================================================================
# Storage & Persistence Backend
# ==============================================================================
# Conversation memory storage: 'local' (file-based) or 'firestore' (Cloud Firestore)
MEMORY_STORE_TYPE=local

# ==============================================================================
# Server & Runtime Configuration
# ==============================================================================
PORT=3001
NODE_ENV=development
USE_CONFIG_FILE=true
CONFIG_PATH=