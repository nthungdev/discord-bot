{
  "name": "chat-bot-app",
  "version": "0.2.0",
  "description": "discord bot",
  "author": "Hung Nguyen",
  "license": "ISC",
  "scripts": {
    "clean": "rm -rf build",
    "prebuild": "pnpm clean",
    "build": "tsc",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "debug": "nodemon --inspect src/main.ts",
    "dev": "nodemon src/main.ts",
    "start": "NODE_ENV=production node build/src/main.js",
    "docker-build": "docker compose build",
    "docker-dev": "docker compose -f compose.yaml -f compose.development.yaml up -d",
    "docker-prod": "docker compose -f compose.yaml -f compose.production.yaml up -d",
    "sync-config": "ts-node src/scripts/syncRemoteConfig.ts"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=1.0.0 <2.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@google-cloud/vertexai": "^1.2.0",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.9.0",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.6.8",
    "axios-cache-interceptor": "^1.8.0",
    "body-parser": "^1.20.2",
    "cron": "^3.1.7",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.1.1",
    "google-auth-library": "^9.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
